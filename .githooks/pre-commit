#!/bin/sh
# Pre-commit hook: format Python with ruff, Markdown with prettier.

CHANGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
if [ -n "$CHANGED_PY" ]; then
  echo "$CHANGED_PY" | xargs uv run ruff format --quiet 2>/dev/null || \
    echo "$CHANGED_PY" | xargs ruff format --quiet 2>/dev/null || true
  git add $CHANGED_PY 2>/dev/null || true
fi

CHANGED_MD=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$' || true)
if [ -n "$CHANGED_MD" ]; then
  echo "$CHANGED_MD" | xargs npx prettier --write --log-level=warn 2>/dev/null || true
  git add $CHANGED_MD 2>/dev/null || true
fi
